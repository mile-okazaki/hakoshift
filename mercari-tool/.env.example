# ── Claude API（文章生成・コメント返信・リサーチ要約に使用）───────────────
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル（変更不要）
MERCARI_MODEL=claude-opus-5
# low / medium / high / xhigh / max  … 高いほど品質↑コスト↑
MERCARI_EFFORT=medium

# ── データ保存先 ──────────────────────────────────────────────
MERCARI_DATA_DIR=./data

# ── Googleスプレッドシート連携 ──────────────────────────────────
# サービスアカウントのJSONキーのパス
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json
# 連携先スプレッドシートのキー（URLの /d/ と /edit の間の文字列）
GOOGLE_SPREADSHEET_KEY=
# もしくはスプレッドシート名で指定
GOOGLE_SPREADSHEET_NAME=メルカリ売上管理

# ── 相場リサーチ ────────────────────────────────────────────
# 既定は手動データ（CSV/JSON）からの分析。
# 外部HTTP取得を使う場合のみ 1 にする。利用規約・robots.txt の遵守は利用者責任。
MERCARI_ALLOW_HTTP_RESEARCH=0
# HTTP取得を使う場合の検索エンドポイント（JSONを返すもの）
MERCARI_RESEARCH_ENDPOINT=
# リクエスト間隔（秒）。短くしすぎない。
MERCARI_RESEARCH_INTERVAL=3.0

# ── 販売条件のデフォルト ─────────────────────────────────────
# 目標利益率（0.30 = 30%）
MERCARI_TARGET_MARGIN=0.30
# 値下げ交渉で許容する最低利益率
MERCARI_MIN_MARGIN=0.12
